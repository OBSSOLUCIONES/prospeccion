}

/* Ocultar barra de scroll en carruseles táctiles */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Animaciones Táctiles de Alta Frecuencia (60fps Android Native) */
.active-press {
  transition: transform 0.12s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.12s ease;
}
.active-press:active {
  transform: scale(0.96);
  opacity: 0.88;
}
