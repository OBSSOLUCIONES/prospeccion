                {/* Acciones Rápidas Móviles */}
                <div className="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
                  
                  {/* Botones de Contacto Directo */}
                  <div className="flex items-center gap-1.5">
                    {tieneTelefono ? (
                      <>
                        <a 
                          href={`tel:${telLimpio}`}
                          className="h-9 px-3 bg-blue-50 hover:bg-blue-100 active:scale-95 text-blue-800 font-bold text-xs rounded-xl border border-blue-200 flex items-center gap-1.5 transition-all"
                          title="Llamar al cliente">
                          <Phone className="w-3.5 h-3.5 text-blue-600" />
                          <span>Llamar</span>
                        </a>

                        <button
                          type="button"
                          onClick={() => abrirWhatsAppCliente(cli.contacto, cli.nombreCliente, cli.responsable, cli.sucursal)}
                          className="h-9 px-3 bg-emerald-50 hover:bg-emerald-100 active:scale-95 text-emerald-800 font-bold text-xs rounded-xl border border-emerald-200 flex items-center gap-1.5 transition-all"
                          title="Escribir por WhatsApp">
                          <MessageCircle className="w-3.5 h-3.5 text-emerald-600" />
                          <span>WhatsApp</span>
                        </button>
                      </>
                    ) : (
                      <span className="text-[11px] font-semibold text-slate-400 italic">Sin teléfono registrado</span>
                    )}
                  </div>

                  {/* Botón Cómo Llegar */}
                  <button 
                    type="button"
                    onClick={() => onAbrirRuta({
                      nombre: cli.nombreCliente,
                      direccion: cli.direccion,
                      lat: cli.lat,
                      lng: cli.lng
                    })}
                    className="h-9 px-3 text-slate-800 bg-slate-100 hover:bg-slate-200 active:scale-95 font-bold text-xs rounded-xl flex items-center gap-1.5 transition-all shrink-0 ml-auto">
                    <Navigation className="w-3.5 h-3.5 text-blue-600" />
                    <span>Ruta</span>
                  </button>

                </div>

              </div>
            );
          })}
        </div>
      )}

    </div>
  );
}
</file>

