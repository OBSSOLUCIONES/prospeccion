// src/lib/supabase.js
import { createClient } from '@supabase/supabase-js';

function sanitizarUrlSupabase(url) {
  if (!url) return '';
  let limpia = url.trim();
  limpia = limpia.replace(/^(https?:\/\/)+/gi, '');
  limpia = limpia.replace(/^https?\/\//gi, '');
  return `https://${limpia}`;
}

const rawUrl = import.meta.env.VITE_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;

const supabaseUrl = sanitizarUrlSupabase(rawUrl);

export const isSupabaseConfigured = Boolean(
  supabaseUrl && 
  supabaseAnonKey && 
  !supabaseUrl.includes('tu-id-de-proyecto') &&
  supabaseUrl.includes('.supabase.co')
);

export const supabase = isSupabaseConfigured
  ? createClient(supabaseUrl, supabaseAnonKey)
  : null;

// =======================================================
// COMPRESIÓN DE IMÁGENES CLIENT-SIDE (ESTILO WHATSAPP)
// Reduce archivos de 8MB a ~200KB (Ahorra 95% de espacio)
// =======================================================
export async function comprimirImagen(file, maxDimension = 1280, calidad = 0.75) {
  // Si no es imagen (ej. es un PDF de cotización), no se toca
  if (!file.type.startsWith('image/')) {
    return file;
  }

  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        let width = img.width;
        let height = img.height;

        // Redimensionar manteniendo proporción
        if (width > height) {
          if (width > maxDimension) {
            height = Math.round((height * maxDimension) / width);
            width = maxDimension;
          }
        } else {
          if (height > maxDimension) {
            width = Math.round((width * maxDimension) / height);
            height = maxDimension;
          }
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        // Convertir a JPEG optimizado
        canvas.toBlob(
          (blob) => {
            if (!blob) {
              resolve(file); // Fallback en caso de error
              return;
            }
            const nombreLimpio = file.name.replace(/\.[^/.]+$/, "") + '.jpg';
            const archivoComprimido = new File([blob], nombreLimpio, {
              type: 'image/jpeg',
              lastModified: Date.now()
            });
            resolve(archivoComprimido);
          },
          'image/jpeg',
          calidad
        );
      };
      img.onerror = () => resolve(file);
      img.src = e.target.result;
    };
    reader.onerror = () => resolve(file);
    reader.readAsDataURL(file);
  });
}

// ==========================================
// SUBIDA DE ARCHIVOS (STORAGE) CON COMPRESIÓN
// ==========================================
export async function subirArchivoSupabase(file, folder = 'fotos') {
  if (!supabase) {
    return URL.createObjectURL(file);
  }

  // ✅ Comprime la imagen antes de enviarla a la red
  const archivoAEnviar = await comprimirImagen(file);

  const extension = archivoAEnviar.name.split('.').pop();
  const nombreLimpio = `${folder}/${Date.now()}_${Math.random().toString(36).substring(2, 8)}.${extension}`;

  const { error: uploadError } = await supabase.storage
    .from('evidencias-obras')
    .upload(nombreLimpio, archivoAEnviar, {
      cacheControl: '31536000', // Caché de 1 año para no gastar ancho de banda
      upsert: false
    });

  if (uploadError) {
    console.error('Error subiendo archivo a Supabase:', uploadError);
    return URL.createObjectURL(file);
  }

  const { data } = supabase.storage
    .from('evidencias-obras')
    .getPublicUrl(nombreLimpio);

  return data.publicUrl;
}

// ==========================================
// MAPEO DE DATOS (CamelCase <-> SnakeCase)
// ==========================================
const mapearClienteDesdeDB = (c) => ({
  id: c.id,
  sucursal: c.sucursal,
  idRedAzul: c.id_red_azul || '',
  nombreCliente: c.nombre_cliente,
  tipoCliente: c.tipo_cliente,
  tipoMercado: c.tipo_mercado || '',
  responsable: c.responsable,
  contacto: c.contacto || '',
  correo: c.correo || '',
  direccion: c.direccion || '',
  lat: c.lat,
  lng: c.lng,
  ubicacion: c.ubicacion || ''
});

const mapearClienteParaDB = (c) => ({
  id: c.id,
  sucursal: c.sucursal,
  id_red_azul: c.idRedAzul || null,
  nombre_cliente: c.nombreCliente,
  tipo_cliente: c.tipoCliente,
  tipo_mercado: c.tipoMercado || null,
  responsable: c.responsable,
  contacto: c.contacto || null,
  correo: c.correo || null,
  direccion: c.direccion || null,
  lat: c.lat || null,
  lng: c.lng || null,
  ubicacion: c.ubicacion || null
});

const mapearVisitaDesdeDB = (v) => ({
  id: v.id,
  sucursal: v.sucursal,
  fecha: v.fecha,
  proyecto: v.proyecto,
  clienteId: v.cliente_id || '',
  tipoDesarrollo: v.tipo_desarrollo,
  estatus: v.estatus,
  actividad: v.actividad,
  monto: v.monto || '',
  tipoEntrega: v.tipo_entrega,
  formaPago: v.forma_pago,
  folioDocumento: v.folio_documento || '',
  documentoAdjunto: v.documento_adjunto || null,
  antecedentePresupuesto: v.antecedente_presupuesto || '',
  observaciones: v.observaciones || '',
  fotos: v.fotos || [],
  lat: v.lat,
  lng: v.lng,
  ubicacion: v.ubicacion || ''
});

const mapearVisitaParaDB = (v) => ({
  id: v.id,
  sucursal: v.sucursal,
  fecha: v.fecha,
  proyecto: v.proyecto,
  cliente_id: v.clienteId || null,
  tipo_desarrollo: v.tipoDesarrollo,
  estatus: v.estatus,
  actividad: v.actividad,
  monto: v.monto || null,
  tipo_entrega: v.tipoEntrega,
  forma_pago: v.formaPago,
  folio_documento: v.folioDocumento || null,
  documento_adjunto: v.documentoAdjunto || null,
  antecedente_presupuesto: v.antecedentePresupuesto || null,
  observaciones: v.observaciones || null,
  fotos: v.fotos || [],
  lat: v.lat || null,
  lng: v.lng || null,
  ubicacion: v.ubicacion || null
});

// ==========================================
// CONSULTAS Y OPERACIONES (CRUD)
// ==========================================
export async function obtenerClientesDB() {
  if (!supabase) return null;
  const { data, error } = await supabase
    .from('clientes')
    .select('*')
    .order('id', { ascending: true });

  if (error) throw error;
  return data.map(mapearClienteDesdeDB);
}

export async function guardarClienteDB(cliente) {
  if (!supabase) return;
  const fila = mapearClienteParaDB(cliente);
  const { error } = await supabase.from('clientes').upsert(fila);
  if (error) throw error;
}

export async function eliminarClienteDB(id) {
  if (!supabase) return;
  const { error } = await supabase.from('clientes').delete().eq('id', id);
  if (error) throw error;
}

export async function obtenerVisitasDB() {
  if (!supabase) return null;
  const { data, error } = await supabase
    .from('visitas')
    .select('*')
    .order('created_at', { ascending: false });

  if (error) throw error;
  return data.map(mapearVisitaDesdeDB);
}

export async function guardarVisitaDB(visita) {
  if (!supabase) return;
  const fila = mapearVisitaParaDB(visita);
  const { error } = await supabase.from('visitas').upsert(fila);
  if (error) throw error;
}

export async function eliminarVisitaDB(id) {
  if (!supabase) return;
  const { error } = await supabase.from('visitas').delete().eq('id', id);
  if (error) throw error;
}

export async function obtenerUsuariosDB() {
  if (!supabase) return null;
  const { data, error } = await supabase
    .from('usuarios')
    .select('*')
    .order('nombre', { ascending: true });

  if (error) {
    console.warn('Aviso con tabla usuarios:', error);
    return null;
  }
  return data;
}

export async function guardarUsuarioDB(usuario) {
  if (!supabase) return;
  const { error } = await supabase.from('usuarios').upsert(usuario);
  if (error) throw error;
}

// Agrega estas funciones al final de src/lib/supabase.js:

/**
 * Transmite la posición GPS de la tablet a Supabase
 */
export async function transmitirPosicionDB({ usuarioId, nombre, sucursal, lat, lng, accuracy }) {
  if (!supabase || !usuarioId) return;

  const { error } = await supabase.from('posiciones_en_vivo').upsert({
    usuario_id: usuarioId,
    nombre,
    sucursal,
    lat,
    lng,
    accuracy,
    updated_at: new Date().toISOString()
  });

  if (error) console.error('Error transmitiendo GPS:', error);
}

/**
 * Carga inicial y suscripción Realtime para el Director
 */
export async function obtenerPosicionesEnVivoDB() {
  if (!supabase) return [];
  const { data, error } = await supabase.from('posiciones_en_vivo').select('*');
  if (error) {
    console.warn('Aviso cargando posiciones en vivo:', error);
    return [];
  }
  return data || [];
}

export function suscribirPosicionesEnVivo(onUpdate) {
  if (!supabase) return () => {};

  const canal = supabase
    .channel('rastreo-flota-realtime')
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'posiciones_en_vivo' },
      () => {
        // Al detectar un cambio de cualquier asesor, recarga las posiciones
        obtenerPosicionesEnVivoDB().then(onUpdate);
      }
    )
    .subscribe();

  return () => {
    supabase.removeChannel(canal);
  };
}
