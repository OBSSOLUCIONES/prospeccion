        {esDirector ? (
          <div className="space-y-3">
            
            {/* Tarjeta Consolidada General */}
            <div className="bg-gradient-to-r from-[#001757] to-[#002b80] text-white p-4 rounded-2xl shadow-sm space-y-2">
              <div className="flex items-center justify-between">
