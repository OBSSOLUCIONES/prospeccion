                    title="Editar">
                    <Pencil className="w-3.5 h-3.5" />
                  </button>
                  <button 
                    onClick={() => onEliminarVisita(ultima)}
                    className="w-8 h-8 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors active:scale-90"
                    title="Eliminar">
                    <Trash2 className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>

              {/* Renglón 2: Nombre de Obra y Fase Constructiva */}
              <div className="flex items-start justify-between gap-2">
                <div className="min-w-0">
                  <h3 className="text-base font-extrabold text-slate-900 leading-snug truncate">
                    {obra.proyecto}
                  </h3>
                  <p className="text-xs text-slate-500 font-semibold mt-0.5">
                    <span className="text-blue-700">{obra.sucursal}</span> • {obra.tipoDesarrollo}
                  </p>
                </div>

                <span className={`px-2.5 py-1 rounded-full text-[11px] font-extrabold border shrink-0 ${FASE_COLORS[obra.estatusActual]}`}>
                  {obra.estatusActual}
                </span>
              </div>

              {/* Renglón 3: Último Avance con botón "+ Visita" corregido */}
