<file path="src/components/PipelineTab.jsx">
// src/components/PipelineTab.jsx
import React, { useState, useMemo } from 'react';
import { 
  Search, Tag, FileText, Eye, Camera, ShieldCheck, 
  Navigation, Pencil, Trash2, DollarSign, TrendingUp, Briefcase, 
  Share2, MapPin, Lock, AlertTriangle, Compass, Target, 
  Flame, Snowflake, MessageCircle, BarChart3, ChevronDown, Plus, BookOpen
} from 'lucide-react';
import { SUCURSALES, FASES_OBRA, FASE_COLORS } from '../data/constants';
import ResumenKpis from './ResumenKpis';
import ModalHistorialObra from './ModalHistorialObra';

const parseMonto = (str) => {
  if (!str) return 0;
  const num = parseFloat(String(str).replace(/[^0-9.]/g, ''));
  return isNaN(num) ? 0 : num;
};

const formatearMoneda = (val) => {
  return new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
    maximumFractionDigits: 0
  }).format(val);
};

const calcularDiasDesdeVisita = (fechaStr) => {
  if (!fechaStr) return 0;
  try {
    const fechaLimpia = fechaStr.includes('T') ? fechaStr : fechaStr.replace(' ', 'T');
    const fechaVisita = new Date(fechaLimpia);
    if (isNaN(fechaVisita.getTime())) return 0;
    const hoy = new Date();
    const diffDias = Math.floor((hoy.getTime() - fechaVisita.getTime()) / (1000 * 60 * 60 * 24));
    return Math.max(0, diffDias);
  } catch {
    return 0;
  }
};

export default function PipelineTab({ 
  visitas, clientes = [], search, setSearch, filtroFase, setFiltroFase, filtroSucursal, setFiltroSucursal, 
  onVerVisor, onEditarVisita, onEliminarVisita, onAbrirRuta, usuarioActivo, onRegistrarVisitaAObra 
}) {
  const esAdmin = usuarioActivo?.sucursal === 'TODAS';
  const [filtroEspecial, setFiltroEspecial] = useState('TODAS');
  const [modalKpisAbierto, setModalKpisAbierto] = useState(false);
  const [obraHistorialSeleccionada, setObraHistorialSeleccionada] = useState(null);

  const visitasPorSucursal = visitas.filter(
    v => filtroSucursal === 'TODAS' || v.sucursal === filtroSucursal
  );

  // Agrupación de visitas en Obras únicas
  const obrasAgrupadas = useMemo(() => {
    const mapa = {};

    visitasPorSucursal.forEach(v => {
      const clave = `${v.sucursal}___${v.proyecto.trim().toLowerCase()}`;

      if (!mapa[clave]) {
        mapa[clave] = {
          id: v.id,
          claveObra: clave,
          proyecto: v.proyecto,
          clienteId: v.clienteId,
          sucursal: v.sucursal,
          tipoDesarrollo: v.tipoDesarrollo,
          direccionObra: v.direccionObra,
          lat: v.lat,
          lng: v.lng,
          visitas: []
        };
      }

      mapa[clave].visitas.push(v);
    });

    return Object.values(mapa).map(obra => {
      obra.visitas.sort((a, b) => new Date(b.fecha.replace(' ', 'T')) - new Date(a.fecha.replace(' ', 'T')));
      const ultima = obra.visitas[0];

      return {
        ...obra,
        ultimaVisita: ultima,
        estatusActual: ultima.estatus,
        actividadActual: ultima.actividad,
        fechaUltimaVisita: ultima.fecha,
        montoActual: ultima.monto,
        auditoriaEstado: ultima.auditoriaEstado,
        distanciaAuditoriaMetros: ultima.distanciaAuditoriaMetros,
        fotos: ultima.fotos || [],
        observaciones: ultima.observaciones,
        documentoAdjunto: ultima.documentoAdjunto,
        totalVisitas: obra.visitas.length
      };
    });
  }, [visitasPorSucursal]);

  const totalMonto = visitasPorSucursal.reduce((acc, v) => acc + parseMonto(v.monto), 0);
  const totalObras = obrasAgrupadas.length;
  const ventasCerradas = visitasPorSucursal.filter(v => v.actividad === 'VENTA').length;

  const fechaHoyStr = new Date().toISOString().slice(0, 10);
  const visitasHoy = visitasPorSucursal.filter(v => v.fecha && v.fecha.startsWith(fechaHoyStr)).length;
  const metaDiaria = 5;
  const porcentajeMeta = Math.min(100, Math.round((visitasHoy / metaDiaria) * 100));
  const totalObrasFrias = obrasAgrupadas.filter(o => calcularDiasDesdeVisita(o.fechaUltimaVisita) > 12).length;

  // Mensaje Comercial Inteligente de WhatsApp
  const enviarSeguimientoWhatsApp = (obra) => {
    const ultima = obra.ultimaVisita;
    const clienteVinculado = clientes.find(c => c.id === obra.clienteId);
    const telLimpio = clienteVinculado?.contacto ? clienteVinculado.contacto.replace(/\D/g, '') : '';
    const responsable = clienteVinculado?.responsable ? ` ${clienteVinculado.responsable}` : '';
    const nombreAsesor = usuarioActivo?.nombre ? usuarioActivo.nombre : 'tu asesor comercial';
    const sucursalTexto = obra.sucursal ? `OBS ${obra.sucursal}` : 'OBS';

    const actividad = (ultima.actividad || '').toUpperCase();
    const monto = ultima.monto;
    const fase = obra.estatusActual;

    let mensaje = `Hola${responsable}, buen día. Te escribe ${nombreAsesor} de ${sucursalTexto}.\n\n`;

    if (actividad === 'VENTA' || actividad === 'POSTVENTA') {
      mensaje += `Te contacto para dar seguimiento al suministro de tu pedido para la obra *${obra.proyecto}* (${fase}).\n\n`;
      if (monto) mensaje += `Confirmando la atención de tu compra por *${monto}*.\n\n`;
      mensaje += `¿Todo llegó en orden con el flete y la descarga en obra? Quedo a tus órdenes para programar tus siguientes colados o entregas de material.\n\n¡Muchas gracias por tu confianza!`;
    } else if (actividad === 'COTIZACIÓN' || monto) {
      mensaje += `Dando seguimiento a la cotización de materiales para la obra *${obra.proyecto}*, actualmente en fase de *${fase}*.\n\n`;
      if (monto) mensaje += `Tenemos en revisión tu propuesta por *${monto}*.\n\n`;
      mensaje += `¿Cómo viste los precios y tiempos de entrega? Si gustas, te apartamos el material para garantizarte el suministro en tu fecha de colado.\n\n¡Quedo a tus órdenes!`;
    } else {
      mensaje += `Estuvimos dando una vuelta por tu obra *${obra.proyecto}* y vemos un excelente avance en la etapa de *${fase}*.\n\n`;
      mensaje += `Quedo a tu disposición si requieres apoyo cuantificando materiales o preparando una propuesta para tus siguientes etapas.\n\n¡Mucho éxito en la jornada!`;
    }

    const textoUrl = encodeURIComponent(mensaje);
    if (telLimpio && telLimpio.length >= 7) {
      const telFinal = telLimpio.length === 10 ? `52${telLimpio}` : telLimpio;
      window.open(`https://wa.me/${telFinal}?text=${textoUrl}`, '_blank');
    } else {
      window.open(`https://api.whatsapp.com/send?text=${textoUrl}`, '_blank');
    }
  };

  const obrasProcesadas = obrasAgrupadas
    .filter(o => filtroFase === 'TODAS' || o.estatusActual === filtroFase)
    .filter(o => {
      if (filtroEspecial === 'HOY') return o.fechaUltimaVisita && o.fechaUltimaVisita.startsWith(fechaHoyStr);
      if (filtroEspecial === 'FRIAS') return calcularDiasDesdeVisita(o.fechaUltimaVisita) > 12;
      return true;
    })
    .filter(o => 
      o.proyecto.toLowerCase().includes(search.toLowerCase()) || 
      o.actividadActual.toLowerCase().includes(search.toLowerCase()) || 
      o.id.toLowerCase().includes(search.toLowerCase())
    );

  return (
    <div className="space-y-3 pb-24">
      
      {/* 1. BARRA SUPERIOR COMPACTA DE MÉTRICAS */}
      <div className="bg-white p-2.5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between gap-2">
        <div className="flex items-center gap-2 min-w-0">
          <div className="w-8 h-8 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center shrink-0">
            <Target className="w-4 h-4 text-blue-600 stroke-[2.5]" />
          </div>
          <div className="min-w-0">
            <p className="text-xs font-extrabold text-slate-900 truncate">
              Hoy: <span className="text-blue-700">{visitasHoy} de {metaDiaria} visitas</span>
            </p>
            <p className="text-[10px] font-bold text-slate-400 truncate">
              {totalObras} obras activas • {formatearMoneda(totalMonto)}
            </p>
          </div>
        </div>

        <button
          type="button"
          onClick={() => setModalKpisAbierto(true)}
          className="h-8 px-3 bg-blue-50 hover:bg-blue-100 active:scale-95 text-blue-800 font-extrabold text-xs rounded-xl border border-blue-200 flex items-center gap-1.5 shrink-0 transition-all shadow-2xs">
          <BarChart3 className="w-3.5 h-3.5 text-blue-600" />
          <span>Métricas</span>
        </button>
      </div>

      {/* 2. BÚSQUEDA Y SUCURSAL */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <div className="relative w-full">
          <Search className="w-4 h-4 absolute left-3.5 top-3.5 text-slate-400" />
          <input 
            type="text"
            placeholder="Buscar por nombre de obra, folio o fase..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="w-full h-11 pl-10 pr-4 rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-900 outline-none focus:border-blue-600 shadow-xs"
          />
        </div>

        {esAdmin ? (
          <select
            value={filtroSucursal}
            onChange={(e) => setFiltroSucursal(e.target.value)}
            className="w-full h-11 px-3 rounded-xl border border-blue-300 bg-blue-50/70 text-xs font-bold text-blue-950 outline-none shadow-xs">
            <option value="TODAS">Todas las Sucursales ({SUCURSALES.length})</option>
            {SUCURSALES.map(suc => (
              <option key={suc.codigo} value={suc.nombre}>{suc.nombre} ({suc.codigo})</option>
            ))}
          </select>
        ) : (
          <div className="w-full h-11 px-3.5 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-800 flex items-center justify-between shadow-xs">
            <div className="flex items-center gap-1.5">
              <MapPin className="w-4 h-4 text-blue-600" />
              <span>Sucursal: {usuarioActivo?.sucursal}</span>
            </div>
            <span className="text-[10px] font-bold text-slate-400 flex items-center gap-1">
              <Lock className="w-3 h-3" /> Fija
            </span>
          </div>
        )}
      </div>

      {/* 3. FILTROS CON TEXTO CORTO (SIN TEXTOS CORTADOS) */}
      <div className="grid grid-cols-2 gap-2">
        <div className="relative">
          <select
            value={filtroEspecial}
            onChange={(e) => setFiltroEspecial(e.target.value)}
            className={`w-full h-10 pl-3 pr-7 rounded-xl border text-xs font-extrabold outline-none appearance-none transition-all shadow-2xs truncate ${
              filtroEspecial === 'FRIAS'
                ? 'bg-rose-50 border-rose-300 text-rose-800'
                : filtroEspecial === 'HOY'
                ? 'bg-blue-50 border-blue-300 text-blue-800'
                : 'bg-white border-slate-300 text-slate-700'
            }`}>
            <option value="TODAS">Obras: Todas ({obrasAgrupadas.length})</option>
            <option value="HOY">Visitas de Hoy ({visitasHoy})</option>
            <option value="FRIAS">Obras Frías ({totalObrasFrias})</option>
          </select>
          <ChevronDown className="w-4 h-4 absolute right-2.5 top-3 text-slate-400 pointer-events-none" />
        </div>

        <div className="relative">
          <select
            value={filtroFase}
            onChange={(e) => setFiltroFase(e.target.value)}
            className={`w-full h-10 pl-3 pr-7 rounded-xl border text-xs font-extrabold outline-none appearance-none transition-all shadow-2xs truncate ${
              filtroFase !== 'TODAS'
                ? 'bg-blue-50 border-blue-300 text-blue-800'
                : 'bg-white border-slate-300 text-slate-700'
            }`}>
            <option value="TODAS">Fases: Todas</option>
            {FASES_OBRA.map(fase => {
              const count = obrasAgrupadas.filter(o => o.estatusActual === fase).length;
              return (
                <option key={fase} value={fase}>
                  {fase} ({count})
                </option>
              );
            })}
          </select>
          <ChevronDown className="w-4 h-4 absolute right-2.5 top-3 text-slate-400 pointer-events-none" />
        </div>
      </div>

      {/* 4. TARJETAS DE OBRAS CON DISEÑO SIMÉTRICO Y BIEN ALINEADO */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-3.5 pt-1">
        {obrasProcesadas.map(obra => {
          const diasPasados = calcularDiasDesdeVisita(obra.fechaUltimaVisita);
          const esObraFria = diasPasados > 12;
          const ultima = obra.ultimaVisita;

          return (
            <div key={obra.claveObra} className="w-full bg-white rounded-3xl border border-slate-200/90 p-4 shadow-sm space-y-3">
              
              {/* Renglón 1: Badges superiores y Botones de Edición */}
