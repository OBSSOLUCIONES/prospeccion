  input[type="date"] {
    text-transform: none;
  }
}

/* Área Segura para Tablets y Celulares con Notch / Barra Inferior Android */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 16px);
}

.safe-top {
  padding-top: env(safe-area-inset-top, 0px);
}

/* Contenedor del Mapa Satelital */
.leaflet-container {
  width: 100%;
  height: 100%;
  border-radius: 1.5rem;
  z-index: 10;
