                          title="Editar Cliente">
                          <Pencil className="w-4 h-4" />
                        </button>
                        <button 
                          type="button"
                          onClick={() => onEliminarCliente(cli)}
                          className="w-9 h-9 rounded-xl text-slate-500 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors active:scale-90"
                          title="Eliminar Cliente">
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </div>
                  </div>

                  {/* Datos de Contacto y Responsable */}
                  <div className="border-t border-slate-100 pt-2.5 mt-2 text-xs space-y-1.5 text-slate-700">
                    <p className="flex items-center gap-1.5">
                      <User className="w-3.5 h-3.5 text-blue-600 shrink-0" />
                      <strong className="text-slate-900 font-bold">Encargado:</strong>
                      <span className="font-semibold text-slate-800 truncate">{cli.responsable || 'No asignado'}</span>
                    </p>

                    <p className="flex items-start gap-1.5">
                      <MapPin className="w-3.5 h-3.5 text-rose-500 shrink-0 mt-0.5" />
                      <span className="line-clamp-2 text-slate-600 font-medium">{cli.direccion || 'Sin dirección registrada'}</span>
