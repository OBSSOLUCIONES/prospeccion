                          tipo: 'foto', 
                          fotos: obra.fotos, 
                          index: idx, 
                          titulo: `${obra.proyecto} (${idx + 1}/${obra.fotos.length})` 
                        })}
                        className="w-16 h-16 rounded-xl object-cover border-2 border-slate-200 cursor-pointer shrink-0 hover:opacity-90 active:scale-95 transition-all shadow-xs"
                      />
                    ))}
                  </div>
                </div>
              )}

              {/* Renglón 5: Observaciones */}
              {obra.observaciones && (
                <p className="text-xs text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-100 font-medium leading-relaxed">
                  "{obra.observaciones}"
                </p>
              )}

              {/* Renglón 6: Barra Inferior con botones equilibrados */}
              <div className="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                
                {/* Badge de Auditoría Satelital */}
                <div className="shrink-0">
                  {obra.auditoriaEstado === 'remoto' ? (
                    <span className="inline-flex items-center gap-1 text-rose-700 bg-rose-50 border border-rose-200 px-2 py-1 rounded-lg text-[10px] font-extrabold">
                      <AlertTriangle className="w-3 h-3 text-rose-600" /> Remoto
                    </span>
                  ) : obra.auditoriaEstado === 'perimetro' ? (
                    <span className="inline-flex items-center gap-1 text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded-lg text-[10px] font-extrabold">
                      <Compass className="w-3 h-3 text-amber-600" /> Perímetro
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-lg text-[10px] font-extrabold">
                      <ShieldCheck className="w-3 h-3 text-emerald-600" /> En Obra
                    </span>
                  )}
                </div>

                {/* Botones de Acción (WhatsApp y Ruta compactos y sin encimarse) */}
                <div className="flex items-center gap-1.5 shrink-0">
                  <button
                    type="button"
                    onClick={() => enviarSeguimientoWhatsApp(obra)}
                    className={`h-9 px-3 active:scale-95 text-white font-extrabold text-xs rounded-xl shadow-xs transition-all flex items-center gap-1.5 ${
                      obra.actividadActual === 'VENTA' || obra.actividadActual === 'POSTVENTA'
                        ? 'bg-blue-600 hover:bg-blue-700'
                        : 'bg-emerald-600 hover:bg-emerald-700'
                    }`}>
                    <MessageCircle className="w-3.5 h-3.5" />
                    <span>WhatsApp</span>
                  </button>

                  <button 
                    type="button"
                    onClick={() => onAbrirRuta({
                      nombre: obra.proyecto,
                      direccion: obra.direccionObra || `Folio ${obra.id}`,
                      lat: obra.lat,
                      lng: obra.lng
                    })}
                    className="h-9 px-3 text-blue-700 bg-blue-50 hover:bg-blue-100 active:scale-95 font-extrabold text-xs rounded-xl border border-blue-200 transition-all flex items-center gap-1.5">
                    <Navigation className="w-3.5 h-3.5 text-blue-600" />
                    <span>Ruta</span>
                  </button>
                </div>

              </div>

            </div>
          );
        })}
      </div>

      {/* Modal Deslizable de Métricas y KPIs */}
      <ResumenKpis
        isOpen={modalKpisAbierto}
        onClose={() => setModalKpisAbierto(false)}
        sucursal={filtroSucursal}
        visitasHoy={visitasHoy}
        metaDiaria={metaDiaria}
        porcentajeMeta={porcentajeMeta}
        totalMonto={totalMonto}
        totalObras={totalObras}
        ventasCerradas={ventasCerradas}
        totalObrasFrias={totalObrasFrias}
      />

      {/* Modal de Bitácora / Historial de la Obra */}
      <ModalHistorialObra
        isOpen={Boolean(obraHistorialSeleccionada)}
        onClose={() => setObraHistorialSeleccionada(null)}
        obra={obraHistorialSeleccionada}
        onVerVisor={onVerVisor}
      />

    </div>
  );
}
</file>

