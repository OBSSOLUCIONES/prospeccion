// src/components/ModalVisita.jsx
import React, { useState, useEffect, useRef } from 'react';
import { 
  X, Building2, FileText, UploadCloud, Camera, 
  Image as ImageIcon, ShieldCheck, Trash2, Loader2, MapPin, 
  Check, Mic, MicOff, Zap, FileSpreadsheet, Compass, BookOpen
} from 'lucide-react';
import { SUCURSALES, FASES_OBRA, CAT_TIPO_DESARROLLO, CAT_TIPO_ENTREGA, CAT_FORMA_PAGO, CAT_ACTIVIDAD } from '../data/constants';
import { subirArchivoSupabase } from '../lib/supabase';

function calcularDistanciaMetros(lat1, lon1, lat2, lon2) {
  if (!lat1 || !lon1 || !lat2 || !lon2) return 0;
  const R = 6371e3;
  const rad = Math.PI / 180;
  const dLat = (lat2 - lat1) * rad;
  const dLon = (lon2 - lon1) * rad;
  const a = 
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(lat1 * rad) * Math.cos(lat2 * rad) * 
    Math.sin(dLon / 2) * Math.sin(dLon / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return Math.round(R * c);
}

const obtenerFechaHoraActual = () => {
  const ahora = new Date();
  const y = ahora.getFullYear();
  const m = String(ahora.getMonth() + 1).padStart(2, '0');
  const d = String(ahora.getDate()).padStart(2, '0');
  const h = String(ahora.getHours()).padStart(2, '0');
  const min = String(ahora.getMinutes()).padStart(2, '0');
  return `${y}-${m}-${d}T${h}:${min}`;
};

export default function ModalVisita({ 
  isOpen, onClose, onSave, visitas, clientes, tabletPos, visitaAEditar, 
  obraPreseleccionada, onAbrirMapaPicker, usuarioActivo 
}) {
  const [modoFormulario, setModoFormulario] = useState('express');
  
  const [grabandoVoz, setGrabandoVoz] = useState(false);
  const recognitionRef = useRef(null);
  const debeSeguirGrabandoRef = useRef(false);

  const [form, setForm] = useState({
    sucursal: 'ALTOZANO',
    fecha: obtenerFechaHoraActual(),
    proyecto: '',
    clienteId: '',
    tipoDesarrollo: 'OBRA NUEVA',
    estatus: 'PRELIMINARES',
    actividad: 'VISITA',
    monto: '',
    tipoEntrega: 'DOMICILIO',
    formaPago: 'TRANSFERENCIA',
    folioDocumento: '',
    documentoAdjunto: null,
    antecedentePresupuesto: '',
    observaciones: '',
    fotos: [],
    lat: null,
    lng: null,
    direccionObra: '',
    ubicacionConfirmada: false
  });

  const [subiendoArchivo, setSubiendoArchivo] = useState(false);
  const [clienteCercano, setClienteCercano] = useState(null);

  useEffect(() => {
    return () => {
      debeSeguirGrabandoRef.current = false;
      if (recognitionRef.current) {
        try { recognitionRef.current.stop(); } catch (_) {}
      }
    };
  }, []);

  useEffect(() => {
    if (visitaAEditar) {
      setForm({
        ...visitaAEditar,
        fecha: visitaAEditar.fecha.includes('T') ? visitaAEditar.fecha : visitaAEditar.fecha.replace(' ', 'T'),
        ubicacionConfirmada: Boolean(visitaAEditar.lat && visitaAEditar.lng)
      });
      setModoFormulario('express');
    } else if (obraPreseleccionada) {
      setForm({
        sucursal: obraPreseleccionada.sucursal,
        fecha: obtenerFechaHoraActual(),
        proyecto: obraPreseleccionada.proyecto,
        clienteId: obraPreseleccionada.clienteId || '',
        tipoDesarrollo: obraPreseleccionada.tipoDesarrollo || 'OBRA NUEVA',
        estatus: obraPreseleccionada.estatusActual || 'CIMENTACIÓN',
        actividad: 'VISITA',
        monto: '',
        tipoEntrega: 'DOMICILIO',
        formaPago: 'TRANSFERENCIA',
        folioDocumento: '',
        documentoAdjunto: null,
        antecedentePresupuesto: '',
        observaciones: '',
        fotos: [],
        lat: obraPreseleccionada.lat,
        lng: obraPreseleccionada.lng,
        direccionObra: obraPreseleccionada.direccionObra || '',
        ubicacionConfirmada: Boolean(obraPreseleccionada.lat && obraPreseleccionada.lng)
      });
      setModoFormulario('express');
    } else {
      const latActual = tabletPos?.lat || null;
      const lngActual = tabletPos?.lng || null;

      setForm({
        sucursal: (usuarioActivo && usuarioActivo.sucursal !== 'TODAS') ? usuarioActivo.sucursal : 'ALTOZANO',
        fecha: obtenerFechaHoraActual(),
        proyecto: '',
        clienteId: '',
        tipoDesarrollo: 'OBRA NUEVA',
        estatus: 'PRELIMINARES',
        actividad: 'VISITA',
        monto: '',
        tipoEntrega: 'DOMICILIO',
        formaPago: 'TRANSFERENCIA',
        folioDocumento: '',
        documentoAdjunto: null,
        antecedentePresupuesto: '',
        observaciones: '',
        fotos: [],
        lat: latActual,
        lng: lngActual,
        direccionObra: '',
        ubicacionConfirmada: Boolean(latActual && lngActual)
      });
      setModoFormulario('express');

      if (latActual && lngActual && clientes && clientes.length > 0) {
        let menorDistancia = Infinity;
        let mejorCandidato = null;

        clientes.forEach(c => {
          if (c.lat && c.lng) {
            const dist = calcularDistanciaMetros(latActual, lngActual, parseFloat(c.lat), parseFloat(c.lng));
            if (dist < menorDistancia && dist <= 400) {
              menorDistancia = dist;
              mejorCandidato = { ...c, distancia: dist };
            }
          }
        });

        setClienteCercano(mejorCandidato);
      }
    }
  }, [visitaAEditar, obraPreseleccionada, isOpen, tabletPos, clientes, usuarioActivo]);

  const toggleDictadoVoz = () => {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      alert('El dictado por voz requiere Google Chrome o Safari en tu dispositivo.');
      return;
    }

    if (grabandoVoz) {
      debeSeguirGrabandoRef.current = false;
      setGrabandoVoz(false);
      if (recognitionRef.current) {
        try { recognitionRef.current.stop(); } catch (_) {}
      }
      return;
    }

    try {
      const recognition = new SpeechRecognition();
      recognition.lang = 'es-MX';
      recognition.continuous = true;
      recognition.interimResults = false;

      debeSeguirGrabandoRef.current = true;
      setGrabandoVoz(true);

      recognition.onresult = (event) => {
        let textoNuevo = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
          if (event.results[i].isFinal) {
            textoNuevo += ' ' + event.results[i][0].transcript;
          }
        }

        if (textoNuevo.trim()) {
          setForm(prev => ({
            ...prev,
            observaciones: prev.observaciones 
              ? `${prev.observaciones.trim()} ${textoNuevo.trim()}` 
              : textoNuevo.trim()
          }));
        }
      };

      recognition.onend = () => {
        if (debeSeguirGrabandoRef.current) {
          try {
            recognition.start();
          } catch (_) {
            setTimeout(() => {
              if (debeSeguirGrabandoRef.current) {
                try { recognition.start(); } catch (__) {}
              }
            }, 250);
          }
        } else {
          setGrabandoVoz(false);
        }
      };

      recognition.onerror = (e) => {
        if (e.error === 'no-speech') return;
        if (e.error === 'not-allowed') {
          alert('Por favor concede permisos de micrófono a la aplicación.');
          debeSeguirGrabandoRef.current = false;
          setGrabandoVoz(false);
        }
      };

      recognitionRef.current = recognition;
      recognition.start();
    } catch (err) {
      debeSeguirGrabandoRef.current = false;
      setGrabandoVoz(false);
    }
  };

  const aplicarClienteCercano = () => {
    if (!clienteCercano) return;
    setForm(prev => ({
      ...prev,
      clienteId: clienteCercano.id,
      proyecto: clienteCercano.nombreCliente,
      direccionObra: clienteCercano.direccion || prev.direccionObra,
      lat: clienteCercano.lat ? parseFloat(clienteCercano.lat) : prev.lat,
      lng: clienteCercano.lng ? parseFloat(clienteCercano.lng) : prev.lng,
      ubicacionConfirmada: true
    }));
    setClienteCercano(null);
  };

  if (!isOpen) return null;

  const sucursalObj = SUCURSALES.find(s => s.nombre === form.sucursal) || SUCURSALES[0];
  const existentes = visitas.filter(v => v.id && v.id.startsWith(sucursalObj.codigo)).length;
  const idMostrado = visitaAEditar ? visitaAEditar.id : `${sucursalObj.codigo}${String(existentes + 1).padStart(2, '0')}`;
  
  // Número de visita en la historia de la obra
  const numeroVisitaHistoria = obraPreseleccionada ? obraPreseleccionada.totalVisitas + 1 : 1;

  const handleDocumento = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setSubiendoArchivo(true);
    try {
      const url = await subirArchivoSupabase(file, 'documentos');
      setForm(prev => ({
        ...prev,
        documentoAdjunto: {
          nombre: file.name,
          tipo: file.type.includes('pdf') ? 'pdf' : 'imagen',
          url
        }
      }));
    } catch (err) {
      alert('Error al subir el documento');
    } finally {
      setSubiendoArchivo(false);
      e.target.value = '';
    }
  };

  const handleFotos = async (e) => {
    const files = Array.from(e.target.files);
    if (!files.length) return;
    setSubiendoArchivo(true);
    try {
      const urlsSubidas = await Promise.all(
        files.map(file => subirArchivoSupabase(file, 'fotos'))
      );
      setForm(prev => ({ ...prev, fotos: [...prev.fotos, ...urlsSubidas] }));
    } catch (err) {
      alert('Error al subir las fotos');
    } finally {
      setSubiendoArchivo(false);
      e.target.value = '';
    }
  };

  const handleEliminarFoto = (index) => {
    setForm(prev => ({
      ...prev,
      fotos: prev.fotos.filter((_, idx) => idx !== index)
    }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (subiendoArchivo) return;

    debeSeguirGrabandoRef.current = false;
    if (recognitionRef.current) {
      try { recognitionRef.current.stop(); } catch (_) {}
    }

    const latObra = form.lat || tabletPos.lat;
    const lngObra = form.lng || tabletPos.lng;
    const latGpsReal = tabletPos?.lat || latObra;
    const lngGpsReal = tabletPos?.lng || lngObra;

    const distancia = calcularDistanciaMetros(latObra, lngObra, latGpsReal, lngGpsReal);

    let estadoAuditoria = 'en_sitio';
    if (distancia > 1000) {
      estadoAuditoria = 'remoto';
    } else if (distancia > 250) {
      estadoAuditoria = 'perimetro';
    }

    onSave({
      id: idMostrado,
      ...form,
      fecha: form.fecha.replace('T', ' '),
      lat: latObra,
      lng: lngObra,
      latGpsReal,
      lngGpsReal,
      distanciaAuditoriaMetros: distancia,
      auditoriaEstado: estadoAuditoria,
      ubicacion: `https://maps.google.com/?q=${latObra},${lngObra}`
    });
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4">
      <div className="w-full sm:max-w-xl max-h-[94vh] bg-white rounded-t-3xl sm:rounded-3xl p-4 sm:p-5 shadow-2xl flex flex-col overflow-hidden animate-in slide-in-from-bottom duration-200">
        
        {/* Cabecera */}
        <div className="flex items-center justify-between pb-2.5 border-b border-slate-100 shrink-0">
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-base font-extrabold text-slate-900">
                {visitaAEditar ? 'Editar Visita' : obraPreseleccionada ? `Registrar Visita #${numeroVisitaHistoria}` : 'Nueva Obra / Visita #1'}
              </h2>
              <span className="bg-blue-600 text-white font-mono font-bold text-xs px-2.5 py-1 rounded-lg">
                {idMostrado}
              </span>
            </div>
            <p className="text-[11px] text-slate-500 font-medium mt-0.5">
              {obraPreseleccionada ? `Sumando bitácora a: ${obraPreseleccionada.proyecto}` : 'Captura de obra con auditoría satelital'}
            </p>
          </div>
          <button 
            type="button" 
            onClick={onClose} 
            className="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 active:scale-90 flex items-center justify-center text-slate-600 transition-all">
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Banner de Obra Preseleccionada */}
        {obraPreseleccionada && (
          <div className="mt-2.5 p-3 bg-blue-50 border border-blue-200 rounded-2xl flex items-center justify-between gap-2">
            <div className="min-w-0">
              <div className="flex items-center gap-1.5 text-blue-900 text-xs font-bold">
                <BookOpen className="w-4 h-4 text-blue-600" />
                <span>Bitácora de Obra (Visita #{numeroVisitaHistoria})</span>
              </div>
              <p className="text-xs font-extrabold text-blue-950 truncate mt-0.5">{obraPreseleccionada.proyecto}</p>
            </div>
            <span className="text-[10px] font-bold bg-white text-blue-800 px-2 py-1 rounded-lg border border-blue-200">
              Ubicación Fijada
            </span>
          </div>
        )}

        {/* Sugerencia de Cercanía si es obra nueva */}
        {!obraPreseleccionada && clienteCercano && (
          <div className="mt-2.5 p-3 bg-emerald-50 border border-emerald-300 rounded-2xl flex items-center justify-between gap-2 animate-in fade-in">
            <div className="min-w-0">
              <div className="flex items-center gap-1 text-emerald-800 text-xs font-bold">
                <Compass className="w-3.5 h-3.5 animate-spin" />
                <span>¿Estás en esta obra? ({clienteCercano.distancia}m)</span>
              </div>
              <p className="text-xs font-bold text-emerald-950 truncate mt-0.5">{clienteCercano.nombreCliente}</p>
            </div>
            <button
              type="button"
              onClick={aplicarClienteCercano}
              className="bg-emerald-600 active:scale-95 hover:bg-emerald-700 text-white font-bold text-xs px-3 py-2 rounded-xl shrink-0 shadow-xs">
              Sí, vincular
            </button>
          </div>
        )}

        {/* Selector de Modo */}
        <div className="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-2xl mt-2.5 shrink-0">
          <button
            type="button"
            onClick={() => setModoFormulario('express')}
            className={`py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition-all ${
              modoFormulario === 'express'
                ? 'bg-white text-blue-700 shadow-sm'
                : 'text-slate-500 hover:text-slate-800'
            }`}>
            <Zap className="w-4 h-4 text-amber-500 fill-amber-500" />
            <span>⚡ Check-in Rápido</span>
          </button>

          <button
            type="button"
            onClick={() => setModoFormulario('comercial')}
            className={`py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition-all ${
              modoFormulario === 'comercial'
                ? 'bg-white text-blue-700 shadow-sm'
                : 'text-slate-500 hover:text-slate-800'
