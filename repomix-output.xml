                <div className="min-w-0">
                  <span className="text-[10px] uppercase font-bold text-blue-800 tracking-wider block">Último Avance:</span>
                  <p className="font-extrabold text-blue-950 text-xs truncate">
                    {obra.actividadActual} {obra.montoActual ? `• ${obra.montoActual}` : ''}
                  </p>
                </div>
                
                {/* Botón "+ Visita" sin el signo duplicado */}
                <button
                  type="button"
                  onClick={() => onRegistrarVisitaAObra(obra)}
                  className="h-8 px-3 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white text-xs font-extrabold rounded-xl flex items-center gap-1 shadow-xs transition-all shrink-0">
                  <Plus className="w-3.5 h-3.5 stroke-[3]" />
                  <span>Visita</span>
                </button>
              </div>

              {/* Renglón 4: Fotos de la última visita */}
              {obra.fotos && obra.fotos.length > 0 && (
                <div className="space-y-1">
                  <p className="text-[11px] font-bold text-slate-600 flex items-center gap-1">
                    <Camera className="w-3.5 h-3.5 text-blue-600" /> Última Evidencia ({obra.fotos.length})
