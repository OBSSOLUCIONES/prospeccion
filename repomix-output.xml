import React from 'react';
import { Layers, Users, MapPin } from 'lucide-react';

export default function BottomNav({ tab, setTab, usuarioActivo }) {
  const esDirector = usuarioActivo?.rol === 'admin' || usuarioActivo?.sucursal === 'TODAS';

  return (
    <nav className="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur border-t border-slate-200/90 px-6 py-2 flex items-center justify-around">
      <button
        onClick={() => setTab('pipeline')}
        className={`flex flex-col items-center gap-1 transition-colors ${
          tab === 'pipeline' ? 'text-blue-600 font-bold' : 'text-slate-400 font-medium'
        }`}>
        <Layers className="w-5 h-5" />
        <span className="text-[10px]">Pipeline</span>
      </button>

      <button
        onClick={() => setTab('clientes')}
        className={`flex flex-col items-center gap-1 transition-colors ${
          tab === 'clientes' ? 'text-blue-600 font-bold' : 'text-slate-400 font-medium'
        }`}>
        <Users className="w-5 h-5" />
        <span className="text-[10px]">Clientes</span>
      </button>

      {/* SOLO VISIBLE PARA EL DIRECTOR GENERAL */}
      {esDirector && (
        <button
          onClick={() => setTab('mapa')}
          className={`flex flex-col items-center gap-1 transition-colors ${
            tab === 'mapa' ? 'text-blue-600 font-bold' : 'text-slate-400 font-medium'
          }`}>
          <MapPin className="w-5 h-5" />
          <span className="text-[10px]">Mapa en Vivo</span>
        </button>
      )}
    </nav>
  );
}
</file>

