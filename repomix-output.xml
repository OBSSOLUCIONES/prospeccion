                <div className="flex items-center gap-1.5 flex-wrap">
                  <span className="text-[11px] font-mono font-bold bg-blue-50 text-blue-800 border border-blue-200 px-2 py-0.5 rounded-lg">
                    {obra.id}
                  </span>

                  <button
                    type="button"
                    onClick={() => setObraHistorialSeleccionada(obra)}
                    className="text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-0.5 rounded-lg flex items-center gap-1 active:scale-95 transition-all">
                    <BookOpen className="w-3 h-3 text-blue-600" />
                    <span>{obra.totalVisitas} visita{obra.totalVisitas > 1 ? 's' : ''}</span>
                  </button>

                  {diasPasados === 0 ? (
                    <span className="text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-lg flex items-center gap-1">
                      <Flame className="w-3 h-3 text-emerald-500" /> Hoy
                    </span>
                  ) : esObraFria ? (
                    <span className="text-[10px] font-extrabold bg-rose-50 text-rose-700 border border-rose-200 px-2 py-0.5 rounded-lg flex items-center gap-1">
                      <Snowflake className="w-3 h-3 text-rose-500" /> Hace {diasPasados}d
                    </span>
                  ) : (
                    <span className="text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-lg">
                      Hace {diasPasados}d
                    </span>
                  )}
                </div>

                {/* Botones de Editar y Borrar bien alineados */}
                <div className="flex items-center gap-0.5 shrink-0">
                  <button 
                    onClick={() => onEditarVisita(ultima)}
