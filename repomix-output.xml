<file path="src/App.jsx">
// src/App.jsx
import React, { useState, useEffect, useRef } from 'react';
import * as XLSX from 'xlsx';
import { Plus, UserPlus, AlertTriangle } from 'lucide-react';

import { CLIENTES_INICIALES, PIPELINE_INICIAL, USUARIOS_INICIALES } from './data/constants';
import Header from './components/Header';
import BottomNav from './components/BottomNav';
import PipelineTab from './components/PipelineTab';
import ClientesTab from './components/ClientesTab';
import MapaTab from './components/MapaTab';
import ModalVisita from './components/ModalVisita';
import ModalCliente from './components/ModalCliente';
import ModalMapaPicker from './components/ModalMapaPicker';
import ModalVisor from './components/ModalVisor';
import ModalNavegacion from './components/ModalNavegacion';
import PantallaPin from './components/PantallaPin';

import { 
  isSupabaseConfigured,
  obtenerClientesDB,
  guardarClienteDB,
  eliminarClienteDB,
  obtenerVisitasDB,
  guardarVisitaDB,
  eliminarVisitaDB,
  obtenerUsuariosDB,
  transmitirPosicionDB,
  obtenerPosicionesEnVivoDB,
  suscribirPosicionesEnVivo
} from './lib/supabase';

const parseMonto = (str) => {
  if (!str) return 0;
  const num = parseFloat(String(str).replace(/[^0-9.]/g, ''));
  return isNaN(num) ? 0 : num;
};

export default function App() {
  const [tab, setTab] = useState('pipeline');
  
  const [usuarioActivo, setUsuarioActivo] = useState(() => {
    const local = localStorage.getItem('app_obras_usuario_activo');
    return local ? JSON.parse(local) : null;
  });

  const [usuarios, setUsuarios] = useState(() => {
    const local = localStorage.getItem('app_obras_usuarios');
    return local ? JSON.parse(local) : USUARIOS_INICIALES;
  });

  const [asesoresEnVivo, setAsesoresEnVivo] = useState([]);

  const [visitas, setVisitas] = useState(() => {
    const local = localStorage.getItem('app_obras_visitas');
    return local ? JSON.parse(local) : PIPELINE_INICIAL;
  });

  const [clientes, setClientes] = useState(() => {
    const local = localStorage.getItem('app_obras_clientes');
    return local ? JSON.parse(local) : CLIENTES_INICIALES;
  });

  const [sincronizando, setSincronizando] = useState(isSupabaseConfigured);
  const [search, setSearch] = useState('');
  const [filtroFase, setFiltroFase] = useState('TODAS');
  const [filtroSucursal, setFiltroSucursal] = useState('TODAS');
  
  const [tabletPos, setTabletPos] = useState({ lat: 19.6642, lng: -101.1718, accuracy: 10 });
  const [gpsEstado, setGpsEstado] = useState('buscando');
  const ultimaTransmisionRef = useRef(0);

  const [modalVisita, setModalVisita] = useState(false);
  const [modalCliente, setModalCliente] = useState(false);
  const [visorModal, setVisorModal] = useState(null);
  const [mapaPickerConfig, setMapaPickerConfig] = useState(null);
  const [destinoRuta, setDestinoRuta] = useState(null);

  const [visitaAEditar, setVisitaAEditar] = useState(null);
  const [obraPreseleccionada, setObraPreseleccionada] = useState(null);
  const [clienteAEditar, setClienteAEditar] = useState(null);
  const [itemAEliminar, setItemAEliminar] = useState(null);

  const [formCliente, setFormCliente] = useState({
    sucursal: 'ALTOZANO',
    nombreCliente: '',
    tipoMercado: '',
    responsable: '',
    contacto: '',
    direccion: '',
    correo: '',
    tipoCliente: 'PROSPECTO',
    idRedAzul: '',
    lat: null,
    lng: null,
    ubicacionConfirmada: false
  });

  const esDirector = usuarioActivo?.rol === 'admin' || usuarioActivo?.sucursal === 'TODAS';

  useEffect(() => {
    if (!esDirector && tab === 'mapa') setTab('pipeline');
  }, [esDirector, tab]);

  useEffect(() => {
    if (usuarioActivo) {
      localStorage.setItem('app_obras_usuario_activo', JSON.stringify(usuarioActivo));
      setFiltroSucursal(usuarioActivo.sucursal === 'TODAS' ? 'TODAS' : usuarioActivo.sucursal);
    } else {
      localStorage.removeItem('app_obras_usuario_activo');
    }
  }, [usuarioActivo]);

  useEffect(() => {
    localStorage.setItem('app_obras_visitas', JSON.stringify(visitas));
  }, [visitas]);

  useEffect(() => {
    localStorage.setItem('app_obras_clientes', JSON.stringify(clientes));
  }, [clientes]);

  useEffect(() => {
    async function sincronizarConSupabase() {
      if (!isSupabaseConfigured) return;
      try {
        const [clientesDB, visitasDB, usuariosDB] = await Promise.all([
          obtenerClientesDB(),
          obtenerVisitasDB(),
          obtenerUsuariosDB()
        ]);

        if (clientesDB && clientesDB.length > 0) setClientes(clientesDB);
        if (visitasDB && visitasDB.length > 0) setVisitas(visitasDB);
        if (usuariosDB && usuariosDB.length > 0) setUsuarios(usuariosDB);

        if (esDirector) {
          const flota = await obtenerPosicionesEnVivoDB();
          setAsesoresEnVivo(flota);
        }
      } catch (err) {
        console.warn('Operando localmente:', err);
      } finally {
        setSincronizando(false);
      }
    }

    sincronizarConSupabase();

    if (esDirector) {
      const desuscribir = suscribirPosicionesEnVivo((flotaActualizada) => {
        setAsesoresEnVivo(flotaActualizada);
      });
      return () => desuscribir();
    }
  }, [esDirector]);

  useEffect(() => {
    if (!('geolocation' in navigator)) {
      setGpsEstado('bloqueado');
      return;
    }

    let wakeLock = null;
    if ('wakeLock' in navigator) {
      navigator.wakeLock.request('screen').then(wl => {
        wakeLock = wl;
      }).catch(() => {});
    }

    const watchId = navigator.geolocation.watchPosition(
      (pos) => {
        const precision = Math.round(pos.coords.accuracy);

        const nuevaPos = {
          lat: pos.coords.latitude,
          lng: pos.coords.longitude,
          accuracy: precision
        };

        setTabletPos(nuevaPos);

        if (precision <= 25) {
          setGpsEstado('activo');
        } else {
          setGpsEstado('calibrando');
        }

        const ahora = Date.now();
        if (usuarioActivo && ahora - ultimaTransmisionRef.current > 25000) {
          ultimaTransmisionRef.current = ahora;
          transmitirPosicionDB({
            usuarioId: usuarioActivo.id,
            nombre: usuarioActivo.nombre,
            sucursal: usuarioActivo.sucursal,
            lat: nuevaPos.lat,
            lng: nuevaPos.lng,
            accuracy: precision
          });
        }
      },
      (err) => {
        console.warn('Error de geolocalización:', err);
        setGpsEstado('bloqueado');
      },
      {
        enableHighAccuracy: true,
        maximumAge: 0,
        timeout: 15000
      }
    );

    return () => {
      navigator.geolocation.clearWatch(watchId);
      if (wakeLock) wakeLock.release();
    };
  }, [usuarioActivo]);

  const visitasVisibles = visitas.filter(v => 
    !usuarioActivo || usuarioActivo.sucursal === 'TODAS' || v.sucursal === usuarioActivo.sucursal
  );

  const clientesVisibles = clientes.filter(c => 
    !usuarioActivo || usuarioActivo.sucursal === 'TODAS' || c.sucursal === usuarioActivo.sucursal
  );

  const handleGuardarVisita = async (visitaData) => {
    try {
      await guardarVisitaDB(visitaData);
    } catch (err) {
      console.error(err);
    }

    if (visitaAEditar) {
      setVisitas(prev => prev.map(v => v.id === visitaAEditar.id ? visitaData : v));
      setVisitaAEditar(null);
    } else {
      setVisitas(prev => [visitaData, ...prev]);
    }
    setObraPreseleccionada(null);
  };

  const handleGuardarCliente = async (clienteData) => {
    try {
      await guardarClienteDB(clienteData);
    } catch (err) {
      console.error(err);
    }

    if (clienteAEditar) {
      setClientes(prev => prev.map(c => c.id === clienteAEditar.id ? clienteData : c));
      setClienteAEditar(null);
    } else {
      setClientes(prev => [clienteData, ...prev]);
    }
  };

  const handleEditarVisita = (visita) => {
    setVisitaAEditar(visita);
    setObraPreseleccionada(null);
    setModalVisita(true);
  };

  const handleEditarCliente = (cliente) => {
    setClienteAEditar(cliente);
    setFormCliente({
      ...cliente,
      ubicacionConfirmada: Boolean(cliente.lat && cliente.lng)
    });
    setModalCliente(true);
  };

  const ejecutarEliminacion = async () => {
    if (!itemAEliminar) return;
    try {
      if (itemAEliminar.tipo === 'visita') {
        await eliminarVisitaDB(itemAEliminar.data.id);
        setVisitas(prev => prev.filter(v => v.id !== itemAEliminar.data.id));
      } else if (itemAEliminar.tipo === 'cliente') {
        await eliminarClienteDB(itemAEliminar.data.id);
        setClientes(prev => prev.filter(c => c.id !== itemAEliminar.data.id));
      }
    } catch (err) {
      console.error(err);
    } finally {
      setItemAEliminar(null);
    }
  };

  // =========================================================================
  // MOTOR DE EXPORTACIÓN A EXCEL: BITÁCORA HISTÓRICA + RESUMEN DE OBRAS
  // =========================================================================
  const exportarAExcel = () => {
    if (!esDirector) return;

    const visitasAExportar = filtroSucursal === 'TODAS'
      ? visitas
      : visitas.filter(v => v.sucursal === filtroSucursal);

    // 1. Agrupar visitas por obra y ordenarlas cronológicamente
    const mapaObras = {};
    visitasAExportar.forEach(v => {
      const clave = `${v.sucursal}___${(v.proyecto || 'S/N').trim().toLowerCase()}`;
      if (!mapaObras[clave]) mapaObras[clave] = [];
      mapaObras[clave].push(v);
    });

    // Ordenar cada grupo del más antiguo al más reciente para numerar: Visita #1, #2, #3...
    const filasBitacora = [];
    const filasResumenObras = [];

    Object.keys(mapaObras).sort().forEach(clave => {
      const listaVisitas = mapaObras[clave];
      listaVisitas.sort((a, b) => new Date((a.fecha || '').replace(' ', 'T')) - new Date((b.fecha || '').replace(' ', 'T')));

      const primera = listaVisitas[0];
      const ultima = listaVisitas[listaVisitas.length - 1];
      const clienteObj = clientes.find(c => c.id === ultima.clienteId);

      // Total acumulado
      const montoTotal = listaVisitas.reduce((acc, vis) => acc + parseMonto(vis.monto), 0);

      // A) Filas de la Bitácora Histórica (Hoja 1)
      listaVisitas.forEach((v, index) => {
        const cliVisita = clientes.find(c => c.id === v.clienteId) || clienteObj;
        
        let auditoriaTexto = 'En Obra (Auditado)';
        if (v.auditoriaEstado === 'remoto') {
          auditoriaTexto = `Captura Remota (a ${v.distanciaAuditoriaMetros ? (v.distanciaAuditoriaMetros / 1000).toFixed(1) : '>1'} km)`;
        } else if (v.auditoriaEstado === 'perimetro') {
          auditoriaTexto = `En Perímetro (${v.distanciaAuditoriaMetros || 0} m)`;
        }

        filasBitacora.push({
          'PROYECTO / OBRA': v.proyecto,
          'SUCURSAL': v.sucursal,
          'NO. VISITA': `Visita #${index + 1}`,
          'FECHA Y HORA': v.fecha,
          'FASE CONSTRUCTIVA': v.estatus,
          'ACTIVIDAD': v.actividad,
          'MONTO REGISTRADO': v.monto || 'N/A',
          'CLIENTE VINCULADO': cliVisita ? `${cliVisita.id} - ${cliVisita.nombreCliente}` : 'No vinculado',
          'RESPONSABLE CLIENTE': cliVisita?.responsable || 'S/N',
          'AUDITORÍA GPS': auditoriaTexto,
          'OBSERVACIONES DE CAMPO': v.observaciones || 'Sin observaciones',
          'FOLIO DOCUMENTO': v.folioDocumento || 'S/N',
          'ENLACE DOCUMENTO': v.documentoAdjunto?.url || 'Sin documento',
          'ENLACE FOTOS': v.fotos?.length ? v.fotos.join(' , ') : 'Sin fotos',
          'MAPA GPS': v.ubicacion || ''
        });
      });

      // B) Fila del Resumen Maestro por Obra (Hoja 2)
      const diffDias = Math.floor((new Date().getTime() - new Date((ultima.fecha || '').replace(' ', 'T')).getTime()) / (1000 * 60 * 60 * 24));

      filasResumenObras.push({
        'PROYECTO / OBRA': ultima.proyecto,
        'SUCURSAL': ultima.sucursal,
        'CLIENTE': clienteObj ? clienteObj.nombreCliente : 'Sin asignar',
        'ENCARGADO': clienteObj?.responsable || 'S/N',
        'CONTACTO': clienteObj?.contacto || 'S/N',
        'FASE ACTUAL': ultima.estatus,
        'TOTAL VISITAS': listaVisitas.length,
        'ÚLTIMO AVANCE': `${ultima.actividad} (${ultima.fecha})`,
        'MONTO ACUMULADO': montoTotal > 0 ? `$ ${montoTotal.toLocaleString('es-MX')} MXN` : (ultima.monto || 'N/A'),
        'ÚLTIMA VISITA': ultima.fecha,
        'DÍAS SIN VISITA': isNaN(diffDias) ? 'N/A' : (diffDias === 0 ? 'Hoy' : `${diffDias} días`),
        'DIRECCIÓN OBRA': ultima.direccionObra || clienteObj?.direccion || 'S/N'
      });
    });

    // 2. Crear el libro con dos pestañas
    const libro = XLSX.utils.book_new();

    const hojaBitacora = XLSX.utils.json_to_sheet(filasBitacora);
    const hojaResumen = XLSX.utils.json_to_sheet(filasResumenObras);

    // Ajustar ancho automático de columnas para que no salgan aplastadas
    hojaBitacora['!cols'] = [
      { wch: 28 }, { wch: 14 }, { wch: 12 }, { wch: 18 }, { wch: 18 },
      { wch: 16 }, { wch: 18 }, { wch: 26 }, { wch: 22 }, { wch: 24 },
      { wch: 38 }, { wch: 16 }, { wch: 25 }, { wch: 25 }, { wch: 35 }
    ];

    hojaResumen['!cols'] = [
      { wch: 28 }, { wch: 14 }, { wch: 28 }, { wch: 20 }, { wch: 15 },
      { wch: 18 }, { wch: 14 }, { wch: 24 }, { wch: 20 }, { wch: 18 },
      { wch: 16 }, { wch: 35 }
    ];

    XLSX.utils.book_append_sheet(libro, hojaBitacora, 'Bitácora Histórica');
    XLSX.utils.book_append_sheet(libro, hojaResumen, 'Resumen de Obras');

    const fechaHoy = new Date().toISOString().slice(0, 10);
    const nombreArchivo = filtroSucursal === 'TODAS'
      ? `Reporte_Ejecutivo_Global_OBS_${fechaHoy}.xlsx`
      : `Reporte_Ejecutivo_${filtroSucursal}_${fechaHoy}.xlsx`;

    XLSX.writeFile(libro, nombreArchivo);
  };

  if (!usuarioActivo) {
    return (
      <PantallaPin 
        usuarios={usuarios} 
        onLogin={(usr) => setUsuarioActivo(usr)} 
      />
    );
  }

  return (
    <div className="min-h-screen w-full max-w-full overflow-x-hidden bg-slate-50 text-slate-900 pb-24">
      
      <Header 
        gpsEstado={gpsEstado} 
        tabletPos={tabletPos} 
        onExportarExcel={exportarAExcel}
        sincronizando={sincronizando}
        usuarioActivo={usuarioActivo}
        onLogout={() => setUsuarioActivo(null)}
      />

      <main className="w-full px-3.5 py-4 space-y-4">
        {tab === 'pipeline' && (
          <PipelineTab 
            visitas={visitasVisibles}
            clientes={clientes}
            search={search}
            setSearch={setSearch}
            filtroFase={filtroFase}
            setFiltroFase={setFiltroFase}
            filtroSucursal={filtroSucursal}
            setFiltroSucursal={setFiltroSucursal}
            onVerVisor={setVisorModal}
            onEditarVisita={handleEditarVisita}
            onEliminarVisita={(v) => setItemAEliminar({ tipo: 'visita', data: v })}
            onAbrirRuta={setDestinoRuta}
            usuarioActivo={usuarioActivo}
            onRegistrarVisitaAObra={(obra) => {
              setVisitaAEditar(null);
              setObraPreseleccionada(obra);
              setModalVisita(true);
            }}
          />
        )}

        {tab === 'clientes' && (
          <ClientesTab 
            clientes={clientesVisibles}
            onNuevoCliente={() => {
              setClienteAEditar(null);
              setFormCliente({
                sucursal: usuarioActivo.sucursal === 'TODAS' ? 'ALTOZANO' : usuarioActivo.sucursal,
                nombreCliente: '',
                tipoMercado: '',
                responsable: usuarioActivo.nombre,
                contacto: '',
                direccion: '',
                correo: '',
                tipoCliente: 'PROSPECTO',
                idRedAzul: '',
                lat: null,
                lng: null,
                ubicacionConfirmada: false
              });
              setModalCliente(true);
            }}
            onEditarCliente={handleEditarCliente}
            onEliminarCliente={(c) => setItemAEliminar({ tipo: 'cliente', data: c })}
            onAbrirRuta={setDestinoRuta}
          />
        )}

        {tab === 'mapa' && esDirector && (
          <MapaTab 
            tabletPos={tabletPos}
            visitas={visitas}
            clientes={clientes}
            onAbrirRuta={setDestinoRuta}
            filtroSucursal={filtroSucursal}
            setFiltroSucursal={setFiltroSucursal}
            asesoresEnVivo={asesoresEnVivo}
          />
        )}
      </main>

      <button
        type="button"
        onClick={() => {
          if (tab === 'clientes') {
            setClienteAEditar(null);
            setFormCliente({
              sucursal: usuarioActivo.sucursal === 'TODAS' ? 'ALTOZANO' : usuarioActivo.sucursal,
              nombreCliente: '',
              tipoMercado: '',
              responsable: usuarioActivo.nombre,
              contacto: '',
              direccion: '',
              correo: '',
              tipoCliente: 'PROSPECTO',
              idRedAzul: '',
              lat: null,
              lng: null,
              ubicacionConfirmada: false
            });
            setModalCliente(true);
          } else {
            setVisitaAEditar(null);
            setObraPreseleccionada(null);
            setModalVisita(true);
          }
        }}
        className="fixed bottom-20 right-4 z-40 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white p-4 rounded-2xl shadow-xl flex items-center gap-2 font-bold text-sm transition-all">
        {tab === 'clientes' ? <UserPlus className="w-5 h-5 stroke-[2.5]" /> : <Plus className="w-5 h-5 stroke-[2.5]" />}
        <span className="pr-1">{tab === 'clientes' ? 'Nuevo Cliente' : 'Nueva Obra'}</span>
      </button>

      <BottomNav tab={tab} setTab={setTab} usuarioActivo={usuarioActivo} />

      <ModalVisita 
        isOpen={modalVisita}
        onClose={() => { setModalVisita(false); setVisitaAEditar(null); setObraPreseleccionada(null); }}
        onSave={handleGuardarVisita}
        visitas={visitasVisibles}
        clientes={clientesVisibles}
        tabletPos={tabletPos}
        visitaAEditar={visitaAEditar}
        obraPreseleccionada={obraPreseleccionada}
        onAbrirMapaPicker={(config) => setMapaPickerConfig(config)}
        usuarioActivo={usuarioActivo}
      />

      <ModalCliente 
        isOpen={modalCliente}
        onClose={() => { setModalCliente(false); setClienteAEditar(null); }}
        onSave={handleGuardarCliente}
        clientes={clientesVisibles}
        formCliente={formCliente}
        setFormCliente={setFormCliente}
        clienteAEditar={clienteAEditar}
        onAbrirMapaPicker={() => {
          setMapaPickerConfig({
            initialPos: formCliente.lat && formCliente.lng ? { lat: formCliente.lat, lng: formCliente.lng } : tabletPos,
            onConfirm: ({ lat, lng, direccion }) => {
              setFormCliente(prev => ({
                ...prev,
                lat,
                lng,
                direccion: direccion || prev.direccion,
                ubicacionConfirmada: true
              }));
            }
          });
        }}
        usuarioActivo={usuarioActivo}
      />

      {mapaPickerConfig && (
        <ModalMapaPicker 
          isOpen={true}
          onClose={() => setMapaPickerConfig(null)}
          initialPos={mapaPickerConfig.initialPos}
          tabletPos={tabletPos}
          onConfirm={(pos) => {
            mapaPickerConfig.onConfirm(pos);
            setMapaPickerConfig(null);
          }}
        />
      )}

      <ModalNavegacion 
        isOpen={Boolean(destinoRuta)}
        onClose={() => setDestinoRuta(null)}
        destino={destinoRuta}
      />

      <ModalVisor 
        visorModal={visorModal}
        onClose={() => setVisorModal(null)}
      />

      {itemAEliminar && (
        <div className="fixed inset-0 z-60 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in duration-150">
          <div className="bg-white w-full max-w-sm rounded-3xl p-5 shadow-2xl space-y-4 border border-slate-100">
            <div className="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto">
              <AlertTriangle className="w-6 h-6" />
            </div>

            <div className="text-center space-y-1">
              <h3 className="text-base font-bold text-slate-900">
                ¿Eliminar {itemAEliminar.tipo === 'visita' ? 'Visita' : 'Cliente'}?
              </h3>
              <p className="text-xs text-slate-500">
                Estás a punto de borrar a <strong className="text-slate-700">{itemAEliminar.data.id} - {itemAEliminar.data.proyecto || itemAEliminar.data.nombreCliente}</strong>.
              </p>
            </div>

            <div className="grid grid-cols-2 gap-2 pt-2">
              <button
                type="button"
                onClick={() => setItemAEliminar(null)}
                className="w-full py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50 active:scale-98 transition-all">
                Cancelar
              </button>
              <button
                type="button"
                onClick={ejecutarEliminacion}
                className="w-full py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs shadow-md shadow-rose-600/20 active:scale-98 transition-all">
                Sí, Eliminar
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
</file>

