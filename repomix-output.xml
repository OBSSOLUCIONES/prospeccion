import React from 'react';
import { Building2, FileSpreadsheet, AlertCircle, RefreshCw, Lock } from 'lucide-react';

export default function Header({ gpsEstado, tabletPos, onExportarExcel, sincronizando, usuarioActivo, onLogout }) {
  const esDirector = usuarioActivo?.rol === 'admin' || usuarioActivo?.sucursal === 'TODAS';

  // Calidad de la señal satelital
  const precision = tabletPos?.accuracy || 0;
  const esOptimo = precision > 0 && precision <= 15;
  const esAceptable = precision > 15 && precision <= 35;

  return (
    <header className="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-xs">
      
      {/* Identidad y Estado Satelital */}
      <div className="flex items-center gap-2.5 min-w-0">
        <div className="w-9 h-9 shrink-0 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm">
          <Building2 className="w-5 h-5" />
        </div>
        <div className="min-w-0">
          <div className="flex items-center gap-2">
            <h1 className="text-base font-bold text-slate-900 truncate">Control de Obras</h1>
            {sincronizando && (
              <RefreshCw className="w-3 h-3 text-blue-500 animate-spin shrink-0" title="Sincronizando..." />
            )}
          </div>
          
          <div className="flex items-center gap-1.5">
            {gpsEstado === 'activo' && (
              <>
                <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0" />
                <p className="text-[11px] text-emerald-700 font-bold truncate">
                  GPS Satelital Óptimo (±{tabletPos.accuracy}m)
                </p>
              </>
            )}
            {gpsEstado === 'calibrando' && (
              <>
                <span className="w-2 h-2 rounded-full bg-amber-500 shrink-0" />
                <p className="text-[11px] text-amber-700 font-medium truncate">
                  GPS Calibrando (±{tabletPos.accuracy}m)
                </p>
              </>
            )}
            {gpsEstado === 'bloqueado' && (
              <>
                <AlertCircle className="w-3.5 h-3.5 text-rose-500 shrink-0" />
                <p className="text-[11px] text-rose-700 font-medium truncate">GPS Bloqueado</p>
              </>
            )}
            {gpsEstado === 'buscando' && (
              <>
                <span className="w-2 h-2 rounded-full bg-blue-400 animate-ping shrink-0" />
                <p className="text-[11px] text-slate-500 truncate">Buscando señal...</p>
              </>
            )}
          </div>
        </div>
      </div>

      {/* Perfil del Usuario y Exportar Excel */}
      <div className="flex items-center gap-2 shrink-0">
        {usuarioActivo && (
          <div className="flex items-center gap-1.5 bg-slate-50 border border-slate-200 pl-1.5 pr-2 py-1 rounded-xl">
            <div className="w-6 h-6 rounded-lg bg-blue-600 text-white font-bold text-[10px] flex items-center justify-center uppercase">
              {usuarioActivo.nombre.substring(0, 2)}
            </div>
            <div className="text-left hidden sm:block">
              <p className="text-[11px] font-bold text-slate-800 leading-none">{usuarioActivo.nombre}</p>
              <span className="text-[9px] font-mono font-semibold text-blue-600 uppercase">
                {usuarioActivo.sucursal}
              </span>
            </div>
            <button 
              type="button"
              onClick={onLogout}
              className="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors ml-0.5"
              title="Bloquear pantalla / Cambiar Asesor">
              <Lock className="w-3.5 h-3.5" />
            </button>
          </div>
        )}

        {esDirector && (
          <button
            onClick={onExportarExcel}
            className="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold shadow-xs transition-all active:scale-95"
            title="Exportar reporte a Excel">
            <FileSpreadsheet className="w-4 h-4" />
            <span className="hidden sm:inline">Excel Power BI</span>
          </button>
        )}
      </div>

    </header>
  );
}
