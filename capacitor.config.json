{
  "appId": "com.prospeccion.obs",
  "appName": "PROSPECCIÓN OBS",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "appendUserAgent": "OBS-APP-v5",
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#000b26"
    }
  }
}